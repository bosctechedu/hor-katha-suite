# ============================================================
# 🔐 ENVIRONMENT VARIABLES — TEMPLATE
# BOSC Tech & Edu · Hoṛ Katha Suite v3.7.4
# ============================================================
#
# ⚠️ IMPORTANT:
#    This is a TEMPLATE file. Copy this to `.env` and fill in
#    your real values. NEVER commit the actual `.env` file to Git.
#
# Usage:
#   1. Copy this file:     cp .env.example .env
#   2. Fill real values in .env
#   3. Verify .env is in .gitignore
#   4. For production: use environment variable services
#
# ════════════════════════════════════════════════════════════
# 🔒 SECURITY LEVELS:
#   🔴 CRITICAL — Never share, never commit
#   🟠 HIGH    — Sensitive, restrict access
#   🟡 MEDIUM  — Limit distribution
#   🟢 LOW     — Public OK
# ════════════════════════════════════════════════════════════
#
# 📋 Quick Checklist:
#   [ ] Copied .env.example → .env
#   [ ] Filled all values below
#   [ ] .env is in .gitignore
#   [ ] No real values in .env.example
#   [ ] Production env vars set (Vercel/Netlify)
#
# ════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 📱 APP INFO (🟢 LOW — Public)
# ═══════════════════════════════════════════════════════════
# These values appear in UI, safe to share.
# ═══════════════════════════════════════════════════════════
APP_NAME="Hoṛ Katha Suite"
APP_VERSION="3.7.4"
APP_ENV="production"
# Options: development | staging | production
APP_DEBUG=false
# true = verbose logs, false = production

# ═══════════════════════════════════════════════════════════
# 🔐 LICENSE PUBLIC KEY — ECDSA P-256 (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Generate using: admin/keygen.html
#
# ⚠️ ONLY PUBLIC key goes here (never private key!)
#
# Steps:
#   1. Open admin/keygen.html
#   2. Click "Generate New Keypair"
#   3. Click "Copy Public Key Line"
#   4. Paste x and y values below
#   5. NEVER expose private key (keep offline backup)
#
# Format example:
#   x = "f83OJ3D2xF1Bg8vub9tLe1gHMzV76e8Tus9uPHvRVEU"
#   y = "x_FEzRu9m36HLN_tue659LNpXW6pCyStikYjKIWI5a0"
# ═══════════════════════════════════════════════════════════
LICENSE_PUBLIC_KEY_KTY="EC"
LICENSE_PUBLIC_KEY_CRV="P-256"
LICENSE_PUBLIC_KEY_X="YOUR_X_COORDINATE_HERE"
LICENSE_PUBLIC_KEY_Y="YOUR_Y_COORDINATE_HERE"

# ═══════════════════════════════════════════════════════════
# 📞 CONTACT INFO (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
# Your WhatsApp number (with country code, no + or spaces)
# Format: 919110977117 (for +91 91109 77117)
#
# Used for: license delivery, customer support
# ═══════════════════════════════════════════════════════════
SUPPORT_WHATSAPP="919110977117"

# Business email (used for receipts, support)
# Format: yourname@example.com
# ═══════════════════════════════════════════════════════════
SELLER_EMAIL="bosctechedu@gmail.com"

# Developer website (optional)
# Format: https://example.com
# ═══════════════════════════════════════════════════════════
DEVELOPER_URL="https://bosctech.in"

# ═══════════════════════════════════════════════════════════
# 💰 PAYMENT (UPI) (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Primary UPI ID (PhonePe / GPay / Paytm)
#
# Example formats:
#   - 9110977117@ybl       (PhonePe)
#   - yourname@okaxis      (Google Pay)
#   - yourname@paytm       (Paytm)
#   - yourname@upi         (BHIM)
# ═══════════════════════════════════════════════════════════
UPI_PRIMARY_ID="YOUR_UPI_ID_HERE"

# NPCI format UPI ID (optional)
# Used for direct NPCI transfers
#
# Example: 37588767033@sbin0003226.ifsc.npci
# ═══════════════════════════════════════════════════════════
UPI_NPCI_ID="YOUR_NPCI_ID_HERE"

# Name registered with UPI/bank
# This is what users see when they pay you
#
# Example: "BOSC Tech and Edu"
# ═══════════════════════════════════════════════════════════
PAYEE_NAME="YOUR_PAYEE_NAME_HERE"

# ═══════════════════════════════════════════════════════════
# 🎁 TRIAL SETTINGS (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
# Trial configuration — usually no need to change
# ═══════════════════════════════════════════════════════════
TRIAL_ENABLED=true
TRIAL_PRICE=9
TRIAL_DURATION_DAYS=7
TRIAL_KEY_PREFIX="HKT"

# Storage keys (advanced — don't change unless you know)
TRIAL_STORAGE_KEY="hor_trial_start"
TRIAL_DEVICE_KEY="hor_trial_device"
TRIAL_KEY_STORAGE="hor_trial_key"

# Warning thresholds (in days)
TRIAL_WARNING_DAYS="6,7"

# ═══════════════════════════════════════════════════════════
# 💳 LICENSE PLANS (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
# Pricing in INR (Indian Rupees)
# ═══════════════════════════════════════════════════════════
PLAN_P1_PRICE=199
PLAN_P1_DEVICES=1
PLAN_P1_NAME="Community"

PLAN_P2_PRICE=399
PLAN_P2_DEVICES=3
PLAN_P2_NAME="Commercial"

PLAN_P3_PRICE=699
PLAN_P3_DEVICES=5
PLAN_P3_NAME="Enterprise"

# ═══════════════════════════════════════════════════════════
# 📊 FIREBASE TRACKING (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# For anonymous activation tracking (with user consent)
#
# Setup:
#   1. Create project at https://console.firebase.google.com/
#   2. Enable Realtime Database
#   3. Copy database URL below
#
# Format: https://YOUR-PROJECT-ID.firebasedatabase.app/activations.json
#
# ⚠️ SECURITY: Set Firebase Rules:
#   {
#     "rules": {
#       "activations": {
#         ".read": "auth != null",
#         ".write": true
#       }
#     }
#   }
# ═══════════════════════════════════════════════════════════
TRACKING_ENDPOINT="https://YOUR-FIREBASE-PROJECT.firebasedatabase.app/activations.json"

# Firebase Web Config
# Get from Firebase Console → Project Settings → Web App
# ═══════════════════════════════════════════════════════════
FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
FIREBASE_AUTH_DOMAIN="YOUR_PROJECT.firebaseapp.com"
FIREBASE_DATABASE_URL="https://YOUR_PROJECT-default-rtdb.asia-southeast1.firebasedatabase.app"
FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
FIREBASE_STORAGE_BUCKET="YOUR_PROJECT.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="YOUR_SENDER_ID"
FIREBASE_APP_ID="YOUR_APP_ID"
FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"
# (optional — for analytics, not required)

# ═══════════════════════════════════════════════════════════
# 🌐 DEPLOYMENT (🟢 LOW)
# ═══════════════════════════════════════════════════════════
# Production URL for QR verification links
#
# Example: https://hor-katha.vercel.app/
# ═══════════════════════════════════════════════════════════
BASE_URL="http://localhost:8080"

# ═══════════════════════════════════════════════════════════
# 🎨 UI SETTINGS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
DEFAULT_THEME="dark"
# Options: dark | light

DEFAULT_LANGUAGE="english"
# Options: english | hindi-dev | santali-dev | olchiki | roman

ENABLE_ANALYTICS=false
ENABLE_TELEMETRY=false
# Keep false for privacy — opt-in only

# ═══════════════════════════════════════════════════════════
# 🔒 SECURITY (🟠 HIGH)
# ═══════════════════════════════════════════════════════════
# Clock tamper detection (in minutes)
# If user changes system time, block access
# ═══════════════════════════════════════════════════════════
CLOCK_MAX_ROLLBACK_MINUTES=5
CLOCK_MAX_SERVER_DRIFT_MINUTES=60
CLOCK_MAX_FORWARD_JUMP_DAYS=30

# License key regex validation
# Format: HKP-<plan>-<expiry>-<128 hex chars>
LICENSE_KEY_PATTERN="^HKP-(P[1-3])-(?:\\d{4}|\\d{6})-[A-F0-9]{128}$"

# Trial key regex validation
# Format: HKT-<7 digits>-<4 hex chars>
TRIAL_KEY_PATTERN="^HKT-\\d{7}-[A-F0-9]{4}$"

# HWID format regex
# Format: DVC-XXXX-YYYY
HWID_PATTERN="^DVC-[A-F0-9]{4}-[A-F0-9]{4}$"

# ═══════════════════════════════════════════════════════════
# 📧 EMAIL (Formsubmit.co for receipts) (🟢 LOW)
# ═══════════════════════════════════════════════════════════
# Formsubmit endpoint (auto-generated from SELLER_EMAIL)
#
# Format: https://formsubmit.co/ajax/YOUR_EMAIL
#
# No configuration needed if using config.js auto-generation.
# ═══════════════════════════════════════════════════════════
FORMSUBMIT_ENDPOINT="https://formsubmit.co/ajax/YOUR_EMAIL_HERE"

# ═══════════════════════════════════════════════════════════
# 🖨️ PRINT SETTINGS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
PRINT_HEADER_ENABLED=true
PRINT_FOOTER_ENABLED=true
PRINT_VERSION_ENABLED=true

# ═══════════════════════════════════════════════════════════
# 🎓 CERTIFICATE (🟡 MEDIUM)
# ═══════════════════════════════════════════════════════════
CERTIFICATE_ENABLED=true
CERTIFICATE_QR_ENABLED=true
CERTIFICATE_STYLES="basic,advanced,job"
# Options: basic | advanced | job

# ═══════════════════════════════════════════════════════════
# ⌨️ TYPING TEST (🟢 LOW)
# ═══════════════════════════════════════════════════════════
TYPING_TEST_ENABLED=true
TYPING_TEST_DURATIONS="60,120,300,600"
TYPING_TEST_MIN_WPM=20
TYPING_TEST_MAX_WPM=250

# ═══════════════════════════════════════════════════════════
# 🔊 AUDIO / TTS (🟢 LOW)
# ═══════════════════════════════════════════════════════════
TTS_ENABLED=true
TTS_CHUNK_SIZE=180
TTS_DEFAULT_RATE=1.0
TTS_DEFAULT_PITCH=1.0
TTS_DEFAULT_VOLUME=1.0

AUDIO_CLICK_ENABLED=true
AUDIO_THROTTLE_MS=400

# ═══════════════════════════════════════════════════════════
# 🌐 NETWORK (🟢 LOW)
# ═══════════════════════════════════════════════════════════
# Network timeout (milliseconds)
NETWORK_TIMEOUT_MS=10000
TRACKER_TIMEOUT_MS=8000

# QR code providers (in order of priority)
# These are public APIs — no configuration needed
QR_PROVIDER_1="https://api.qrserver.com/v1/create-qr-code/"
QR_PROVIDER_2="https://quickchart.io/qr"

# ═══════════════════════════════════════════════════════════
# 🚀 PLATFORM-SPECIFIC (Production only)
# ═══════════════════════════════════════════════════════════

# ─── Vercel ────────────────────────────────────────────────
# Add to: Vercel Dashboard → Project Settings → Environment Variables
# Format for Vercel CLI:
#   vercel env add SUPPORT_WHATSAPP
#
# VERCEL_URL is auto-set by Vercel — no need to configure
# ═══════════════════════════════════════════════════════════

# ─── Netlify ───────────────────────────────────────────────
# Add to: Netlify Dashboard → Site Settings → Environment
# Or use netlify.toml:
#
# [build.environment]
#   APP_ENV = "production"
# ═══════════════════════════════════════════════════════════

# ─── GitHub Actions ────────────────────────────────────────
# Add to: Repository Settings → Secrets and variables → Actions
# Access in workflows as: ${{ secrets.SUPPORT_WHATSAPP }}
# ═══════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════
# 📝 NOTES
# ═══════════════════════════════════════════════════════════
#
# 1. NEVER commit the actual `.env` file to Git
#    → Add `.env` to .gitignore
#
# 2. Copy this file to `.env` before filling values
#    → cp .env.example .env
#
# 3. For production, use environment variable services:
#    → Vercel: Project Settings → Environment Variables
#    → Netlify: Site Settings → Build & Deploy → Environment
#    → GitHub Actions: Repository Secrets
#
# 4. Real values should ONLY be in:
#    → Local .env file
#    → Vercel/Netlify dashboard
#    → GitHub Secrets
#    → preload.js (for Electron builds only — secure archive)
#
# 5. Verify setup:
#    → node -e "require('dotenv').config(); console.log(process.env.APP_NAME)"
#
# 6. .gitignore check:
#    → grep "^\.env$" .gitignore
#
# 7. Test in development:
#    → cp .env.example .env
#    → fill values
#    → run: npm start
#
# ═══════════════════════════════════════════════════════════
# END OF ENVIRONMENT TEMPLATE
# ═══════════════════════════════════════════════════════════