{
  "name": "hor-katha-suite",
  "version": "3.7.4",
  "description": "Hoṛ/होड़ Katha Suite — Multi-Script Typing Keyboard for Santali, Hindi, English, Ol Chiki. By BOSC Tech & Edu.",
  "main": "main.js",
  "author": {
    "name": "BOSC Tech & Edu",
    "email": "bosctechedu@gmail.com",
    "url": "https://bosctech.in"
  },
  "license": "ISC",
  "homepage": "https://github.com/bosctech/hor-katha-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/bosctech/hor-katha-suite.git"
  },
  "bugs": {
    "url": "https://github.com/bosctech/hor-katha-suite/issues",
    "email": "bosctechedu@gmail.com"
  },
  "keywords": [
    "santali",
    "hindi",
    "ol-chiki",
    "typing",
    "keyboard",
    "kruti-dev",
    "multi-script",
    "bosc",
    "jharkhand",
    "education"
  ],
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build:win": "electron-builder --win nsis portable --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:nsis": "electron-builder --win nsis --x64",
    "build:dir": "electron-builder --win --dir --x64",
    "clean": "rimraf dist",
    "clean:all": "rimraf dist node_modules/.cache"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "build": {
    "appId": "com.bosctech.horkatha",
    "productName": "Hor Katha Suite Pro",
    "copyright": "Copyright © 2024-2026 BOSC Tech & Edu",
    "asar": true,
    "compression": "normal",
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "manual.html",
      "privacy.html",
      "verify.html",
      "manifest.json",
      "sw.js",
      "main.js",
      "preload.js",
      "package.json",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "!admin/**",
      "!dist/**",
      "!docs/**",
      "!**/*.md",
      "!.gitignore",
      "!.gitattributes",
      "!.env",
      "!.env.*",
      "!package-lock.json",
      "!node_modules/**",
      "!**/*.map",
      "!**/*.log",
      "!build-error.log",
      "!**/.DS_Store",
      "!**/Thumbs.db"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "publisherName": "BOSC Tech & Edu",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName} ${version}.${ext}",
      "legalTrademarks": "Hor Katha Suite"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hor Katha Suite Pro",
      "uninstallDisplayName": "Hor Katha Suite Pro Uninstall",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Hor Katha Suite Pro Setup ${version}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "menuCategory": "BOSC Tech"
    },
    "portable": {
      "artifactName": "Hor Katha Suite Pro ${version} Portable.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}